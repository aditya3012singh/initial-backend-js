enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  PASSED
  FAILED
}

model Problem {
  id            String     @id @default(uuid())
  title         String
  description   String
  constraints   String?
  difficulty    Difficulty

  correctAnswer String     @default("")
  starterConfig String?

  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  submissions Submission[]
  tags        Tag[]
  hints       String[]
  userHints   UserHint[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  problems Problem[]
}

model Submission {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  problem   Problem @relation(fields: [problemId], references: [id])
  problemId String

  code     String // This holds the user's submitted answer string

  status SubmissionStatus @default(PENDING) // PASSED or FAILED

  createdAt DateTime @default(now())
}

model UserHint {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  problem   Problem  @relation(fields: [problemId], references: [id])
  problemId String
  hintIndex Int
  unlockedAt DateTime @default(now())

  @@unique([userId, problemId, hintIndex])
}
